{
  "name": "seo-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/gen-redirects.mjs",
    "build": "astro build && node scripts/seo-check.mjs",
    "build:only": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:check:strict": "node scripts/seo-check.mjs --strict",
    "lighthouse": "lhci autorun",
    "verify": "npm run build && npm run lighthouse",
    "redirects": "node scripts/gen-redirects.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:key": "node scripts/indexnow-key.mjs",
    "font:subset": "node scripts/font-subset.mjs",
    "placeholders": "node scripts/gen-placeholders.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@lhci/cli": "^0.15.1",
    "cheerio": "^1.2.0",
    "lighthouse": "^13.6.0",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3"
  }
}
